# 로컬/루프백 스모크 테스트 전용 설정.
# 127.0.0.1에만 바인딩하므로 LAN/공인 인터넷에 노출되지 않는다.
# 평문 HTTP이므로 외부 공개에는 절대 사용하지 않는다.
:80 {
    bind 127.0.0.1
    reverse_proxy 127.0.0.1:8000
}

# 운영(권장) 설정: 도메인을 연결하면 Caddy가 자동 HTTPS 인증서를 발급한다.
# PLAYAUTO_DOMAIN 환경변수(예: playauto.example.com)를 지정하고 위 :80 블록을
# 삭제한 뒤 아래 블록의 주석을 해제한다. 방화벽에서 80/443을 열어야 한다.
#
# {$PLAYAUTO_DOMAIN} {
#     reverse_proxy 127.0.0.1:8000
# }
