# 로컬/LAN 스모크 테스트 전용 설정.
# 평문 HTTP이므로 공인 인터넷에 그대로 노출하면 안 된다.
:80 {
    reverse_proxy 127.0.0.1:8000
}

# 운영(권장) 설정: 도메인을 연결하면 Caddy가 자동 HTTPS 인증서를 발급한다.
# example.com을 실제 도메인으로 바꾸고, 위 :80 블록을 삭제한 뒤 이 블록의
# 주석을 해제한다. 방화벽에서 80/443을 열어야 인증서 발급이 된다.
#
# example.com {
#     reverse_proxy 127.0.0.1:8000
# }
